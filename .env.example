# Names and placeholders only: never a real value. Copy to .env for local runs.
PORT=8080
# Connects as this domain's own user, never as the administrator (Annex J, J.4).
DATABASE_URL=jdbc:postgresql://localhost:5432/amaranta
DATABASE_USER=sales_app
DATABASE_PASSWORD=
# Public key of the security service (one line, \n escapes) - or JWT_PUBLIC_KEY_FILE.
JWT_PUBLIC_KEY=
CATALOG_API_URL=http://localhost:8082
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000
# Demos and smoke tests only (an ISO instant, e.g. 2026-10-12T15:00:00Z): the service believes it is that moment.
CLOCK_FIXED_AT=
